# =============================================================================
# auto-generate 环境变量配置模板
# =============================================================================
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入您的实际 API 密钥
# 3. .env 文件已添加到 .gitignore，不会被提交到版本控制系统
#
# 格式：VARIABLE_NAME=value
# 注意：LLM 密钥变量以 LLM_ 开头，MinerU 解析变量以 MINERU_ 开头
#
# =============================================================================

# 主阅读引擎 API 密钥（用于文献分析）
# 对应配置文件中的 [Primary_Reader_API] api_key
LLM_PRIMARY_READER_API=your_primary_reader_api_key_here

# 备用阅读引擎 API 密钥（用于长文档处理）
# 对应配置文件中的 [Backup_Reader_API] api_key
LLM_BACKUP_READER_API=your_backup_reader_api_key_here

# 写作引擎 API 密钥（用于生成综述）
# 对应配置文件中的 [Writer_API] api_key
LLM_WRITER_API=your_writer_api_key_here

# 大纲 / 自由模式规划 API 密钥（可选，未配置时自动回退到 Writer_API）
# 对应配置文件中的 [Outline_API] api_key
LLM_OUTLINE_API=your_outline_api_key_here

# 验证引擎 API 密钥（用于交叉验证，可选）
# 对应配置文件中的 [Validator_API] api_key
# 仅在启用验证功能时需要
LLM_VALIDATOR_API=your_validator_api_key_here

# =============================================================================
# MinerU 远程解析配置（可选但推荐）
# =============================================================================
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_MODEL_VERSION=vlm
MINERU_UPLOAD_ENDPOINT=/file-urls/batch
MINERU_POLL_ENDPOINT_TEMPLATES=/extract-results/batch/{batch_id},/extract-results/{batch_id},/extract/task/{batch_id}
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_POLL_TIMEOUT_SECONDS=900
MINERU_REQUEST_MAX_RETRIES=2
MINERU_RETRY_BACKOFF_SECONDS=1.5
ALLOW_LOCAL_PARSE_FALLBACK=true

# =============================================================================
# 注意事项：
# 1. 不要在 .env 文件中使用引号包围值
# 2. 不要在 .env 文件中添加空格（除非它们是值的一部分）
# 3. 不要将 .env 文件提交到版本控制系统
# 4. 如果同时在 .env 和 config.ini 中设置了相同的密钥，.env 中的值将优先使用
# =============================================================================
